# Server
PORT=8080
DATA_FILE=/data/clicks.ndjson           # conversions.ndjson + config.json live alongside it

# Dashboard auth (Basic Auth on the UI + admin APIs)
ADMIN_USER=admin
ADMIN_PASS=change-me

# Click ingestion
INGEST_TOKEN=change-me                   # server-side beacons send this as x-ingest-token
ALLOWED_ORIGINS=https://amsterdamairportto.city,https://colosseum-online.help  # browser beacons (origin-based auth)

# Conversions / revenue
DEFAULT_CURRENCY=EUR                      # fallback when a CSV row has no currency column

# Optional: mirror imported conversions into GA4 (Measurement Protocol)
# Leave blank to keep everything in the self-hosted dashboard only.
GA4_MEASUREMENT_ID=                       # e.g. G-XXXXXXXXXX
GA4_API_SECRET=                           # GA4 Admin > Data Streams > Measurement Protocol API secrets
